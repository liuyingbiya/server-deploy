# ============================================================
#  复制成 .env 后填写真实值：  cp .env.example .env
#  .env 不要提交到 Git（已在 .gitignore 里）
# ============================================================

# ---------- 域名（阿里云买好后解析到服务器 IP）----------
# 例：ai.liuyingbiya.top 与 order.liuyingbiya.top
AI_DOMAIN=ai.example.top
ORDER_DOMAIN=order.example.top

# Let's Encrypt 证书通知邮箱（用你常用的邮箱即可）
ACME_EMAIL=your@email.com

# ---------- 数据库 root 密码 ----------
# 建议改成 20 位随机字符串，只用于内部访问（不对外暴露 3306 端口）
MYSQL_ROOT_PASSWORD=change-me-please

# ---------- 大模型 Key ----------
# 留空也能启动（会自动降级为本地模拟模式）
DEEPSEEK_API_KEY=
